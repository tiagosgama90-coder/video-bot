# Buffer API — https://buffer.com/settings/api
# Copia para .env e preenche. NUNCA commits valores reais.
BUFFER_ACCESS_TOKEN=

# IDs Buffer (corre: npm run canais)
BUFFER_INSTAGRAM_CHANNEL_ID=6a54123e80cc80cdcaa83fda
BUFFER_TIKTOK_CHANNEL_ID=6a54139880cc80cdcaa844c0
BUFFER_TIKTOK_USERNAME=sidusastro

# TikTok US (@sidusastro_en) — LOCALE=en-US
BUFFER_TIKTOK_US_CHANNEL_ID=6a57d0d380cc80cdcabd8c45
BUFFER_TIKTOK_US_USERNAME=sidusastro_en
# LOCALE=en-US

# Firebase Storage
FIREBASE_STORAGE_BUCKET=sidus-app.firebasestorage.app

# Azure Speech — região North Europe = northeurope
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=northeurope

# Horóscopo: só usa siteDaily/HOJE por defeito (nunca dias anteriores).
# Para permitir fallback de dias anteriores em emergência:
# HOROSCOPE_ALLOW_FALLBACK=true

# Teste local: 1 signo aleatório diferente a cada npm run gerar
TESTE_LOCAL=1

# Sidus Studio — catálogo de músicas (grátis, 2 min a configurar)
# Jamendo: ~500 000 faixas — https://devportal.jamendo.com → criar app → Client ID
JAMENDO_CLIENT_ID=
# Pixabay Music: ~250 000 faixas — https://pixabay.com/api/docs/ → API key
PIXABAY_API_KEY=
