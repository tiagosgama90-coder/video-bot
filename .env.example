# Buffer API — https://buffer.com/settings/api
# NUNCA commits este ficheiro com valores reais. Copia para .env e preenche.
BUFFER_ACCESS_TOKEN=

# IDs reais obtidos com: npm run canais
BUFFER_INSTAGRAM_CHANNEL_ID=
BUFFER_TIKTOK_CHANNEL_ID=
BUFFER_TIKTOK_USERNAME=sidusastro

# Firebase Storage — bucket público para vídeos antes do Buffer
# Projeto sidus-app: sidus-app.firebasestorage.app ou sidus-app.appspot.com
FIREBASE_STORAGE_BUCKET=sidus-app.firebasestorage.app

# Azure Speech (voz neural pt-PT — mais humana que Helia)
# Cria recurso grátis em: https://portal.azure.com → Speech
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope
